// Entry point for the application.
// All application logic lives here; the build system type-checks this file.

// ── Library functions (defined before `main` so they are in scope) ─────────

/// Return a greeting for the given name.
fn greet(name: String) -> String {
  "Hello, " + name + "!"
}

/// Return a friendly label for a number's sign.
fn describe_number(n: Int) -> String {
  if n > 0 then "positive"
  else if n < 0 then "negative"
  else "zero"
}

// ── Entry point ────────────────────────────────────────────────────────────

fn main() {
  // Read an optional count from the environment.
  let upto = perform Env.get("COUNT")
  let n = match upto {
    nil => 10,
    _   => perform Int.parse(upto)
  }

  let msg = greet("Nulang")
  perform IO.print(msg)

  // Demonstrate basic operations.
  let sum = n + 42
  perform IO.print("n + 42 = " + perform Int.to_string(sum))

  let desc = describe_number(n)
  perform IO.print("n is " + desc)
}
