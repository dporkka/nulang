#!/usr/bin/env sh
# ---------------------------------------------------------------------------
# Pre-push — thorough checks before pushing to remote
# ---------------------------------------------------------------------------

set -e

# Ensure rustup-managed toolchain used consistently.
export PATH="$HOME/.cargo/bin:$PATH"

echo "→ cargo clippy --all-targets -- -D warnings --cap-lints warn"
cargo clippy --all-targets -- -D warnings --cap-lints warn

echo "→ cargo test"
cargo test

echo "✓ pre-push checks passed"
