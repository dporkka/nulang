// generics_08 — declared type parameters are not skolemized in the function
// body: `fresh[T]() -> T { 0 - 1 }` unifies `T` with Int via the body
// literal, silently pinning the whole function to `() -> Int`. The second
// call site (`String`) then fails. Real behavior: type error at the second
// call site, not at the definition.
fn fresh[T]() -> T {
    0 - 1
}

fn main() {
    let x: Int = fresh()
    let s: String = fresh()
    perform IO.print("x=" + perform Int.to_string(x))
    perform IO.print("s=" + s)
}
