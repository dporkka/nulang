// generics_08 — skolemized type parameters: `fn fresh[T]() -> T { 0 - 1 }`
// now fails at the definition because the body returns Int but the declared
// return type is the skolemized T (a rigid placeholder that cannot unify
// with a concrete type). The error is at the definition, not the call site.
fn fresh[T]() -> T {
    0 - 1
}

fn main() {
    let x: Int = fresh()
    let s: String = fresh()
    perform IO.print("unreachable")
}
