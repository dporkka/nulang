// generics_06 — a class constraint on a type parameter (`[T: Ord]`) where NO
// class `Ord` is declared anywhere: SPEC2 §7.8 says constraints are "planned",
// and the parser accepts the syntax. Real behavior: the constraint is
// silently recorded and never enforced — the body's `==` works on any
// concrete type, so both Int and String call sites check and run.
fn cmp[T: Ord](x: T, y: T) -> Bool {
    x == y
}

fn main() {
    perform IO.print(cmp(1, 2))
    perform IO.print(cmp("a", "b"))
    perform IO.print(cmp(5, 5))
}
