actor Watcher {
    state notices: Int = 0
    behavior system(a, b, c) { self.notices = self.notices + 1 }
    behavior watch(v) {
        perform Actor.trap_exit(true)
        perform Actor.link(v)
        0
    }
    behavior ping() { 999 }
}
actor Victim {
    behavior die() { perform Actor.exit(2) }
}
fn main() {
    let w = spawn Watcher {}
    let v = spawn Victim {}
    let s1 = ask w watch(v)
    let s2 = ask v die()
    let alive = ask w ping()
    perform IO.print(alive)
}
