// http_01: Http.serve(0, handler) binds a real OS listener and returns the
// actual bound port as an Int. The actor declaration routes the program
// through the runtime host (RuntimeVmCallbacks), where Http.serve dispatches.
// A positive port proves a genuine bind: bind failure would return nil,
// which fails the `port > 0` comparison. Port 0 asks the OS for an
// ephemeral port, so no fixed-port contention. No network traffic occurs.
actor Ping {}
fn echo(body: String) -> String {
    body
}
fn main() {
    let port = perform Http.serve(0, echo)
    perform IO.print(port > 0)
    perform IO.print(port < 65536)
}
