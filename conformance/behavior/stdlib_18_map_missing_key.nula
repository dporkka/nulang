// stdlib::map — get on missing key returns -1 (not nil).
// The map::get implementation returns -1 for keys not found in the map,
// regardless of the value type. This is because get() unwraps r.value
// for matching keys, and falls through to `-1` for missing keys.
// For string-valued maps, -1 is still returned (Int, not String).
import stdlib::map

fn main() {
    let m = insert("a", "hello", insert("b", "world", []))
    // Existing keys return their values.
    perform IO.print(get("a", m))
    // Missing key returns -1 (Int), not nil and not "".
    let missing = get("z", m)
    perform IO.print(perform Int.to_string(missing))
}
