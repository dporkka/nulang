// stdlib::list — map and filter. SPEC2.md 14.3 writes `List.map(numbers, f)`;
// the implemented parameter order is map(f, xs) / filter(pred, xs).
import stdlib::list

fn main() {
    let double = fn(x) { x * 2 }
    let is_even = fn(x) { x - (x / 2) * 2 == 0 }
    let m = map(double, [1, 2, 3])
    perform IO.print("map_len=" + perform Int.to_string(length(m)))
    perform IO.print("map0=" + perform Int.to_string(m[0]))
    perform IO.print("map1=" + perform Int.to_string(m[1]))
    perform IO.print("map2=" + perform Int.to_string(m[2]))
    perform IO.print("map_empty=" + perform Int.to_string(length(map(double, []))))
    let f = filter(is_even, [1, 2, 3, 4, 5, 6])
    perform IO.print("filter_len=" + perform Int.to_string(length(f)))
    perform IO.print("filter0=" + perform Int.to_string(f[0]))
    perform IO.print("filter1=" + perform Int.to_string(f[1]))
    perform IO.print("filter2=" + perform Int.to_string(f[2]))
    perform IO.print("filter_none=" + perform Int.to_string(length(filter(is_even, [1, 3, 5]))))
}
