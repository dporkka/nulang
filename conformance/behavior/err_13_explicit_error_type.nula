type MyErr = Oops(String) | Boom
type Result[T, E] = Ok(T) | Error(E)
fn validate(x: Int) -> Int ! MyErr {
    if x < 0 then fail Error(Oops("negative")) else if x == 0 then fail Error(Boom) else Ok(x)
}
perform IO.print(validate(5) catch {
    | Error(Oops(msg)) => 0 - 2
    | Error(Boom) => 0 - 1
})
