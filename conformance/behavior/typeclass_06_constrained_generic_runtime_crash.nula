// typeclass_06 — method call on constrained type variable now resolves
// at the HIR level (DictKind::Param) and the call site passes the concrete
// dictionary argument (infer_type_arg → _impl_Eq_Int).
class Eq[T] {
    fn eq(self: T, other: T) -> Bool
}
impl Eq Int {
    fn eq(self: Int, other: Int) = self == other
}
fn eq_check[T: Eq](a: T, b: T) -> Bool { a.eq(b) }
perform IO.print(eq_check(1, 1))
perform IO.print(eq_check(1, 2))
