// generics_01 — SPEC2 §7.8: generic function with one type parameter,
// instantiated at two different concrete types in one program.
// Proves per-call-site instantiation of `identity[T]`.
fn identity[T](x: T) -> T {
    x
}

fn main() {
    let a = identity(42)
    let b = identity("hello")
    perform IO.print(perform Int.to_string(a))
    perform IO.print(b)
    let c = identity(identity(7))
    perform IO.print("nested=" + perform Int.to_string(c))
}
