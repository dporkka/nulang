// generics_07 — recursive generic ADT with a different shape than Tree.
// After the rigid_vars fix, `type Stream[T] = Nil | Cons((T, Stream[T]))`
// type-checks and constructs correctly.
type Stream[T] = Nil | Cons((T, Stream[T]))

fn main() {
    let s = Cons(1, Cons(2, Nil))
    perform IO.print("ok")
}
