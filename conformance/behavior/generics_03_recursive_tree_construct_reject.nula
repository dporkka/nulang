// generics_03 — SPEC2 §7.8's exact `type Tree[T] = Leaf | Node((Tree[T], T, Tree[T]))`
// example cannot be CONSTRUCTED: the recursive self-reference is represented
// as an opaque `Tree[T]` application that never unifies with the variant type
// of the `Leaf` argument. Real behavior: type error.
type Tree[T] = Leaf | Node((Tree[T], T, Tree[T]))

fn main() {
    let t: Tree[Int] = Node(Leaf, 1, Leaf)
    perform IO.print("unreachable")
}
