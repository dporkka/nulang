// generics_13 — generic function with multiple type parameters:
// `fn pair[A, B](a: A, b: B) -> (A, B)` instantiated at two
// different concrete-type pairs in one program.
fn pair[A, B](a: A, b: B) -> (A, B) {
    (a, b)
}

fn main() {
    let p = pair(42, "hello")
    perform IO.print(perform Int.to_string(p.0))
    perform IO.print(p.1)
    let q = pair(true, 99)
    perform IO.print(q.0)
    perform IO.print(perform Int.to_string(q.1))
}
