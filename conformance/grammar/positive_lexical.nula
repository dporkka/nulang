// Positive cases: lexical structure — comments, pipes, identifiers,
// separators (grammar.ebnf §1, §3 pipe).

// case 01: line comment at end of line
fn l_line_comment() { 1 } // trailing comment
// case 02: full-line comments between declarations
// this whole line is a comment
fn l_after_comment() { 2 }
// case 03: block comment
/* block comment */ fn l_block_comment() { 3 }
// case 04: multi-line block comment
/*
   spanning
   lines
*/
fn l_block_multiline() { 4 }
// case 05: nested block comments (src/lexer.rs:1321)
/* outer /* inner */ still comment */
fn l_block_nested() { 5 }
// case 06: doc comment line
/// doc comment for the function below
fn l_doc_comment() { 6 }
// case 07: identifiers with underscores and digits
fn l_ident_chars() { let my_var_2 = 1; my_var_2 }
// case 08: single-letter identifier
fn l_ident_short() { let x = 1; x }
// case 09: identifier with uppercase tail
fn l_ident_camel() { let myVar = 1; myVar }
// case 10: leading-underscore identifier
fn l_ident_underscore() { let _tmp = 1; _tmp }
// case 11: pipe operator to a function
fn l_pipe() { 1 |> incr }
// case 12: chained pipes (left-associative)
fn l_pipe_chain() { 1 |> incr |> double }
// case 13: pipe with dotted path (grammar.ebnf §3: IDENT [ "." IDENT ])
fn l_pipe_dotted() { 1 |> Math.incr }
// case 14: semicolons as statement separators
fn l_semis() { let a = 1; let b = 2; a + b }
// case 15: blank lines between declarations

fn l_blank_lines() { 15 }

// case 16: mixed semicolon and newline separators
fn l_mixed_seps() { let a = 1
    let b = 2; a + b }
// case 17: shebang on first line is skipped (src/lexer.rs:384)
fn l_after_shebang() { 17 }
// case 18: comment inside a block
fn l_comment_in_block() {
    // inner comment
    18
}
// case 19: block comment inline in an expression boundary
fn l_block_inline() { /* mid */ 19 }
// case 20: string containing comment-like text is not a comment
fn l_comment_text_in_string() { "not // a /* comment */" }
