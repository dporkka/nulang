---
const repo = 'nulang-org/nulang';
const badgeUrl = `https://img.shields.io/github/stars/${repo}?style=flat&logo=github&label=Stars&color=1d4ed8`;
---

<a
	href={`https://github.com/${repo}`}
	class="github-stars-badge"
	target="_blank"
	rel="noopener noreferrer"
	aria-label="View Nulang on GitHub"
>
	<img src={badgeUrl} alt="GitHub stars" width="88" height="20" loading="lazy" decoding="async" />
</a>
