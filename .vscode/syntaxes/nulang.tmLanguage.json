{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nulang",
  "scopeName": "source.nulang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#actors" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.nulang", "match": "//.*$" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nulang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.nulang", "match": "\\\\." }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.nulang", "match": "\\b(if|then|else|match|with|case|handle|resume|receive|after|in|perform|spawn|send|ask|import|module|pub)\\b" },
        { "name": "keyword.other.nulang", "match": "\\b(let|rec|fn|type|actor|behavior|state|effect|agent|workflow|entity|database|persistent|self|unit|nil|true|false|and|or)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "entity.name.type.nulang", "match": "\\b(Int|Float|Bool|String|Unit|Nil|Actor|Option|Result|Some|None|Ok|Error)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.nulang", "match": "(->|=>|\\|>|!=|==|<=|>=|&&|\\|\\||[+\\-*/%<>=!|&^])" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.nulang", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.nulang", "match": "\\b[0-9]+\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.nulang", "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)" }
      ]
    },
    "actors": {
      "patterns": [
        { "name": "entity.name.type.actor.nulang", "match": "\\b(actor)\\s+([A-Z][a-zA-Z0-9_]*)" }
      ]
    }
  }
}
