{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nulang",
  "scopeName": "source.nulang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#annotations" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#capabilities" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nulang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nulang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nulang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nulang",
          "match": "\\\\(n|t|r|0|\\\\|\"|')"
        },
        {
          "name": "constant.character.escape.unicode.nulang",
          "match": "\\\\u\\{[0-9a-fA-F]+\\}"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.nulang",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.nulang",
          "match": "\\\\."
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.modifier.annotation.nulang",
          "match": "(@)(backend|tool|persistent|durable|local|event_sourced|crdt|native|wasm)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.nulang" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(pub\\s+)?(fn)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.nulang" },
            "2": { "name": "storage.type.function.nulang" },
            "3": { "name": "entity.name.function.nulang" }
          }
        },
        {
          "match": "\\b(actor)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.actor.nulang" },
            "2": { "name": "entity.name.type.actor.nulang" }
          }
        },
        {
          "match": "\\b(behavior)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.behavior.nulang" },
            "2": { "name": "entity.name.function.behavior.nulang" }
          }
        },
        {
          "match": "\\b(type|alias)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.nulang" },
            "2": { "name": "entity.name.type.nulang" }
          }
        },
        {
          "match": "\\b(effect)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.effect.nulang" },
            "2": { "name": "entity.name.type.effect.nulang" }
          }
        },
        {
          "match": "\\b(const|let)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.nulang" },
            "2": { "name": "variable.other.definition.nulang" }
          }
        },
        {
          "match": "\\b(import)\\s+([a-zA-Z_][a-zA-Z0-9_:]*)",
          "captures": {
            "1": { "name": "keyword.control.import.nulang" },
            "2": { "name": "entity.name.namespace.nulang" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nulang",
          "match": "\\b(if|then|else|match|case|with|handle|resume|perform|receive|after|return|break|continue|for|while|loop|in|do)\\b"
        },
        {
          "name": "keyword.control.actor.nulang",
          "match": "\\b(spawn|send|link|monitor|remote)\\b"
        },
        {
          "name": "storage.type.nulang",
          "match": "\\b(fn|let|const|type|alias|enum|struct|effect|actor|behavior|state|handler|entity|workflow|agent|module|extern)\\b"
        },
        {
          "name": "storage.modifier.nulang",
          "match": "\\b(pub|priv|durable|persistent|where)\\b"
        },
        {
          "name": "variable.language.self.nulang",
          "match": "\\b(self)\\b"
        }
      ]
    },
    "capabilities": {
      "patterns": [
        {
          "name": "storage.modifier.capability.nulang",
          "match": "(?<=@)\\s*(iso|trn|ref|val|box|tag|lineariso)\\b"
        },
        {
          "name": "storage.modifier.capability.nulang",
          "match": "\\b(iso|trn|ref|val|box|tag|lineariso)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.nulang",
          "match": "\\b(Int|Float|Bool|String|Char|Unit|Nil|Byte|Bytes)\\b"
        },
        {
          "name": "support.type.nulang",
          "match": "\\b(Option|Some|None|Result|Ok|Err|Error|Vec|Array|Map|Set|List|Tuple|Record|Channel|Future|Promise|Stream|Iterator|Actor|ActorRef|Timer|Signal)\\b"
        },
        {
          "name": "support.type.effect.nulang",
          "match": "\\b(IO|Fs|Net|Http|Json|Yaml|Toml|Regex|Crypto|Random|Time|Date|Uuid|Env|Process|LLM|Provider|Database|Crdt|Math|Python)\\b"
        },
        {
          "name": "entity.name.type.nulang",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.nulang",
          "match": "\\b(true|false|nil|unit)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nulang",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.nulang",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.nulang",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.nulang",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.nulang",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.nulang",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.pipe.nulang",
          "match": "(\\|>|\\|)"
        },
        {
          "name": "keyword.operator.send.nulang",
          "match": "(!|<-)"
        },
        {
          "name": "keyword.operator.logical.nulang",
          "match": "(&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.comparison.nulang",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.nulang",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.nulang",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.annotation.nulang",
          "match": "@"
        },
        {
          "name": "keyword.operator.range.nulang",
          "match": "(\\.\\.\\.|\\.\\.)"
        }
      ]
    }
  }
}
